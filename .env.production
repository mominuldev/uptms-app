# Loaded automatically by `next build`. Committed on purpose.
#
# Hostinger's hPanel builds this repository itself and has none of the CI
# variables, so the production origins travel with the code. Without them the
# build prerenders against nothing and fails, and the previous version (or
# nothing) keeps serving. Neither value is a secret: the site URL is public,
# and the API origin is the one the server already calls.
#
# Real secrets (REVALIDATE_SECRET, SITE_TOKEN) must NOT go here; they are read
# at runtime, so they belong in the host's environment (hPanel → Node.js app →
# Environment variables).
API_URL=https://tmsb.decentthemes.com/api/v1
NEXT_PUBLIC_SITE_URL=https://tmsf.decentthemes.com
