# ─────────────────────────────────────────────────────────────────────────────
# UPTMS public website (Next.js). Copy to .env.local and fill in.
# Never commit .env.local. Documented in uptms-ad docs/SETUP.md §4.
# ─────────────────────────────────────────────────────────────────────────────

# Laravel API base (uptms-ad), read only on the server — never exposed to the
# browser. Include the /api/v1 prefix.
API_URL=https://backend.ads4uptms.com/api/v1

# Public origin of this site: canonical URLs, Open Graph, sitemap.
NEXT_PUBLIC_SITE_URL=https://ads4uptms.com

# Search engines may index the site only when this is "true" (production,
# at launch). Anything else: every page is noindex and robots.txt disallows all.
ALLOW_INDEXING=false

# Shared secret Laravel signs the on-publish revalidation webhook with
# (Phase 2). Same value as FRONTEND_REVALIDATE_SECRET in uptms-ad.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Shared with uptms-ad (FRONTEND_SITE_TOKEN): lets the consultation form's
# server action forward the visitor's IP, so Laravel rate-limits per visitor.
# Generate with: openssl rand -hex 32
SITE_TOKEN=

# Cloudflare Turnstile site key for the consultation form. Leave empty to
# turn the widget off (uptms-ad then needs no TURNSTILE_SECRET_KEY either).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
