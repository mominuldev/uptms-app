# ─────────────────────────────────────────────────────────────────────────────
# UPTMS public website (Next.js). Copy to .env.local and fill in.
# Never commit .env.local. Documented in uptms-ad docs/SETUP.md §4.
# ─────────────────────────────────────────────────────────────────────────────

# Laravel API base (uptms-ad), read only on the server — never exposed to the
# browser. Include the /api/v1 prefix.
API_URL=http://localhost:8000/api/v1

# Public origin of this site: canonical URLs, Open Graph, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret Laravel signs the on-publish revalidation webhook with
# (Phase 2). Same value as FRONTEND_REVALIDATE_SECRET in uptms-ad.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Cloudflare Turnstile site key for the consultation form (Phase 3).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
